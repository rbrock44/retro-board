# Copy to .env. The launch scripts do this for you and fill in SESSION_SECRET.
# Every setting is optional; the defaults run a working board on http://localhost:8080.

# ---- your data ----
# Everything stays on this computer. folder: plain folders in ./data (easy to see and copy);
# volumes: Docker-managed volumes. The launch scripts set DB_MOUNT / UPLOADS_MOUNT / APP_UID from this.
DATA_STORAGE=
DB_MOUNT=
UPLOADS_MOUNT=
APP_UID=
APP_GID=
DATA_LOCATION=

# ---- look and defaults ----
# Starting values; admins can change them in the app (Admin > Customize).
# Shown in the top bar and browser tab
SITE_NAME=Retro Board
# auto (light/dark per device), light, dark, midnight, forest, sunset, grape, high-contrast
DEFAULT_THEME=auto
# An accent color on top of the theme, like #3b82f6 (empty: the theme's own)
DEFAULT_ACCENT=
# Columns for new boards: went-well, start-stop-continue, mad-sad-glad, 4ls, sailboat, blank
DEFAULT_TEMPLATE=went-well
DEFAULT_ANONYMOUS=true
# Features switched off for everyone, comma separated, e.g. videos,gifs (admins can change it in Customize):
# images, gifs, videos, anonymous, replies, reactions, likes, groups, actions, carryOver, export, presence, personShades
DISABLED_FEATURES=

# ---- server ----
# Who opens it (read by the launch scripts, which set PUBLIC_URL from it on every launch):
#   local = this computer, network = people on your network at http://<this computer's IP>:PORT,
#   domain = a real address you set up in PUBLIC_URL
ACCESS=local
# Port on your machine
PORT=8080
# The address people type in the browser. Must be right for external sign-in (OAuth redirects).
PUBLIC_URL=http://localhost:8080
# Signs cookies. Use a long random string; changing it signs everyone out.
SESSION_SECRET=change-me
# How long a sign-in lasts
SESSION_DAYS=30
# auto = secure cookies when PUBLIC_URL is https. Force with true/false.
COOKIE_SECURE=auto
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ---- database ----
# docker compose sets DATABASE_URL to its own Postgres. This only changes the password it uses.
POSTGRES_PASSWORD=retro
# Outside docker: postgres://user:pass@host:5432/db, or pglite:./data/pglite for an embedded database.
# DATABASE_URL=

# ---- accounts ----
# Comma-separated emails that become instance admins when they sign up. The first account always does.
ADMIN_EMAILS=

# ---- sign-in ----
# accounts: people sign in to see anything.
# none: no sign-in at all. Anyone who can open the site can see and change everything, and is asked for a
#       name the first time they add a card. Only for trusted networks.
AUTH_MODE=accounts
# Who can create an email/password account: open, invite (team invite link only) or closed
LOCAL_SIGNUP=open

# ---- sign-in providers (accounts mode) ----
# Each button appears on the login page once its values are filled in (then ./launch.sh update).
# Redirect URL to register with each: <PUBLIC_URL>/api/auth/<google|github|microsoft|okta>/callback
# Setup steps: docs/auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# common = any Microsoft account; your tenant id = only your organisation
MS_TENANT=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# https://your-org.okta.com (or .../oauth2/default)
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ---- uploads ----
MAX_UPLOAD_MB=25
# local (a docker volume) or s3 (AWS S3, Cloudflare R2, MinIO, Backblaze B2, …)
STORAGE_DRIVER=local
# S3_BUCKET=retro-board
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=retro
# S3_SECRET_ACCESS_KEY=retro-secret
# S3_FORCE_PATH_STYLE=true

# ---- GIF search ----
# A Tenor API key (Google Cloud console → Tenor API) turns on the GIF button in every composer.
TENOR_API_KEY=
